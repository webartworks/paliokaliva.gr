# Copy this file to ".env" for local work, and set the same values in Coolify
# (Environment Variables) for the live site. Never commit the real ".env".

# Postmark: Servers > your server > API Tokens > "Server API token"
POSTMARK_SERVER_TOKEN=

# Postmark message stream for transactional email (the default stream is "outbound")
POSTMARK_MESSAGE_STREAM=outbound

# Sender address. It must be a verified sender or domain in Postmark.
MAIL_FROM=mailer@webartworks.gr

# Where the hotel receives contact and reservation requests
MAIL_TO=info@paliokaliva.gr
