---
import LineList from './LineList.astro';
import { t, type Locale } from '@/i18n';
import type { Amenity } from '@/data/rooms';

interface Props {
  locale: Locale;
  items: readonly Amenity[];
}

const { locale, items } = Astro.props;
const labels = t(locale).room.amenities;
---

<LineList items={items.map((key) => labels[key])} />
