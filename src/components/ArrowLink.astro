---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['arrow-link', className]} href={href}>
  <slot />
  <svg viewBox="0 0 30 5" aria-hidden="true" focusable="false">
    <path d="M0 2.47v-.657h27.858V0L30 2.142l-2.142 2.141V2.47H0Z"></path>
  </svg>
</Tag>
