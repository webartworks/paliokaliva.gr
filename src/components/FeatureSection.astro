---
// A large photo beside a block of text, with a smaller second photo under the text.
// With `moreImages`, the small photo and those photos form a row of three across the
// whole section, under both the large photo and the text.
// Used for the long, calm sections of inner pages. `reverse` puts the text on the left.
import { Picture } from 'astro:assets';
import { imageFormats } from '@/lib/images';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  quote?: string;
  body: readonly string[];
  image: ImageMetadata;
  alt: string;
  smallImage?: ImageMetadata;
  smallAlt?: string;
  // Two more photos, shown in one row with the small photo.
  moreImages?: readonly { image: ImageMetadata; alt: string }[];
  reverse?: boolean;
  // Shape of the large photo. Use "4 / 5" when the photos are portrait.
  ratio?: string;
  // A silent video (a file in public/) that plays over the large photo while it is on
  // screen. The photo stays as its first frame and as the fallback. Needs the two labels.
  video?: string;
  videoLabels?: { pause: string; play: string };
}

const {
  id,
  eyebrow,
  title,
  quote,
  body,
  image,
  alt,
  smallImage,
  smallAlt = '',
  moreImages = [],
  reverse = false,
  ratio = '3 / 2',
  video,
  videoLabels,
} = Astro.props;
const row = moreImages.length > 0;
---

<section class:list={['feature', { 'feature--reverse': reverse }]} id={id} style={`--ratio:${ratio}`}>
  <div class="container feature__grid">
    <div class="media feature__photo" data-reveal="image">
      <Picture
        src={image}
        alt={alt}
        formats={imageFormats}
        widths={[640, 960, 1400]}
        sizes="(min-width: 56em) 52vw, 100vw"
      />
      {
        video && (
          <>
            <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-auto-video={video} />
            <button
              class="play-toggle"
              type="button"
              hidden
              aria-label={videoLabels?.pause}
              data-video-toggle
              data-pause={videoLabels?.pause}
              data-play={videoLabels?.play}
            >
              <span aria-hidden="true" />
            </button>
          </>
        )
      }
    </div>

    <div class="feature__body">
      <span class="eyebrow" data-reveal>{eyebrow}</span>
      <h2 class="h2" data-reveal style="--i:1">{title}</h2>
      {quote && <p class="quote-mono" data-reveal style="--i:2">{quote}</p>}
      <div class="feature__text" data-reveal style="--i:3">
        {body.map((p) => <p>{p}</p>)}
      </div>
      <div class="feature__extra" data-reveal style="--i:4">
        <slot />
      </div>
      {
        smallImage && !row && (
          <div class="media feature__small" data-reveal="image" style="--i:2">
            <Picture
              src={smallImage}
              alt={smallAlt}
              formats={imageFormats}
              widths={[360, 560, 800]}
              sizes="(min-width: 56em) 24vw, 62vw"
            />
          </div>
        )
      }
    </div>

    {
      smallImage && row && (
        <div class="feature__row">
          {[{ image: smallImage, alt: smallAlt }, ...moreImages].map((photo, i) => (
            <div class="media" data-reveal="image" style={`--i:${i}`}>
              <Picture
                src={photo.image}
                alt={photo.alt}
                formats={imageFormats}
                widths={[400, 640, 960]}
                sizes="(min-width: 56em) 30vw, 33vw"
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .feature {
    padding-block: calc(var(--section) * 0.6);
  }

  .feature__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .feature__photo {
    aspect-ratio: var(--ratio);
  }

  .feature__body {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .feature__body .eyebrow {
    margin-bottom: 1.25rem;
  }

  .feature__text {
    display: grid;
    gap: 1.25rem;
    max-width: 30rem;
    margin-top: 0.5rem;
    text-wrap: pretty;
  }

  .feature__extra:empty {
    display: none;
  }

  .feature__small {
    width: 62%;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    aspect-ratio: 4 / 3;
  }

  .feature__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .feature__row .media {
    aspect-ratio: 4 / 5;
  }

  /* The middle photo sits a little higher, as in the homepage photo strip. */
  .feature__row .media:nth-child(2) {
    margin-top: -0.75rem;
  }

  @media (min-width: 56em) {
    .feature__grid {
      grid-template-columns: 1.25fr 1fr;
      gap: clamp(3rem, 5.5vw, 5rem) clamp(2.5rem, 7vw, 6.25rem);
    }

    .feature--reverse .feature__grid {
      grid-template-columns: 1fr 1.25fr;
    }

    .feature--reverse .feature__photo {
      order: 2;
    }

    .feature__row {
      order: 3;
      grid-column: 1 / -1;
      gap: clamp(0.75rem, 1.5vw, 1.25rem);
    }

    .feature__row .media {
      aspect-ratio: 3 / 2;
    }

    .feature__row .media:nth-child(2) {
      margin-top: -1.25rem;
    }
  }
</style>
