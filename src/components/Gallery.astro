---
// A photo mosaic. Each photo opens large in a viewer with previous / next.
// Without JavaScript the links simply open the large photo.
import { Picture, getImage } from 'astro:assets';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  // `group` is only needed when the page has filter buttons (see the Gallery page).
  photos: { image: ImageMetadata; alt: string; group?: string }[];
  // "mosaic": equal tiles with a large first photo. "masonry": columns that keep each photo's own shape.
  layout?: 'mosaic' | 'masonry';
  // Shape of the small photos, for example "4 / 3" for landscape sets or "4 / 5" for portrait ones.
  ratio?: string;
}

const { locale, photos, ratio = '4 / 3', layout = 'mosaic' } = Astro.props;
const l = t(locale).lightbox;

const items = await Promise.all(
  photos.map(async (photo) => ({
    ...photo,
    large: await getImage({ src: photo.image, width: Math.min(1920, photo.image.width), format: 'webp' }),
  })),
);
---

<ul class:list={['gallery', `gallery--${layout}`]} style={`--ratio:${ratio}`} data-gallery>
  {
    items.map((item, i) => (
      <li class="gallery__item" data-group={item.group} style={`--shape:${item.image.width / item.image.height}`}>
        <a
          class="media gallery__link"
          href={item.large.src}
          aria-label={`${l.open}: ${item.alt}`}
          data-reveal="image"
          data-lightbox
          data-alt={item.alt}
          style={`--i:${i % 3}`}
        >
          <Picture
            src={item.image}
            alt={item.alt}
            formats={['avif', 'webp']}
            widths={[400, 640, 960, 1280]}
            sizes={i === 0 ? '(min-width: 48em) 60vw, 100vw' : '(min-width: 48em) 30vw, 50vw'}
          />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" aria-label={l.label} data-lightbox-dialog data-counter={l.counter}>
  <button class="lightbox__close" type="button" aria-label={l.close} data-lightbox-close>
    <span aria-hidden="true"></span>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label={l.previous} data-lightbox-prev>
    <svg viewBox="0 0 30 5" aria-hidden="true"><path d="M0 2.47v-.657h27.858V0L30 2.142l-2.142 2.141V2.47H0Z"></path></svg>
  </button>
  <figure class="lightbox__figure">
    <img alt="" data-lightbox-image />
    <figcaption aria-live="polite" data-lightbox-count></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label={l.next} data-lightbox-next>
    <svg viewBox="0 0 30 5" aria-hidden="true"><path d="M0 2.47v-.657h27.858V0L30 2.142l-2.142 2.141V2.47H0Z"></path></svg>
  </button>
</dialog>

<style>
  .gallery--mosaic {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: clamp(0.375rem, 0.8vw, 0.75rem);
  }

  .gallery__link {
    display: block;
    aspect-ratio: var(--ratio);
    cursor: zoom-in;
  }

  .gallery__item[hidden] {
    display: none;
  }

  /* Mosaic: the first photo is the large one. */
  .gallery--mosaic .gallery__item:first-child {
    grid-column: span 2;
  }

  /* Masonry: columns of photos in their own shapes. */
  .gallery--masonry {
    --gap: clamp(0.375rem, 0.8vw, 0.75rem);
    columns: 2;
    column-gap: var(--gap);
  }

  .gallery--masonry .gallery__item {
    break-inside: avoid;
    margin-bottom: var(--gap);
  }

  .gallery--masonry .gallery__link {
    aspect-ratio: var(--shape);
  }

  @media (min-width: 48em) {
    .gallery--mosaic {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery--mosaic .gallery__item:first-child {
      grid-row: span 2;
    }

    .gallery--mosaic .gallery__item:first-child .gallery__link {
      height: 100%;
      aspect-ratio: auto;
    }

    .gallery--masonry {
      columns: 3;
    }
  }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(18 17 13 / 0.96);
    color: var(--cream);
    opacity: 0;
    transition:
      opacity 0.5s var(--ease),
      overlay 0.5s allow-discrete,
      display 0.5s allow-discrete;
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    opacity: 1;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    gap: 1rem;
    height: 100dvh;
    min-width: 0;
    padding-block: 4rem 1.5rem;
  }

  .lightbox__figure img {
    align-self: center;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    transition: opacity 0.4s var(--ease);
  }

  .lightbox__figure img.is-loading {
    opacity: 0;
  }

  .lightbox__figure figcaption {
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.26em;
  }

  .lightbox__nav,
  .lightbox__close {
    display: grid;
    place-items: center;
    width: clamp(3rem, 6vw, 5rem);
    height: 3rem;
    color: inherit;
    opacity: 0.75;
    transition: opacity var(--t-fast) var(--ease);
  }

  .lightbox__nav:hover,
  .lightbox__nav:focus-visible,
  .lightbox__close:hover,
  .lightbox__close:focus-visible {
    opacity: 1;
  }

  .lightbox__nav svg {
    width: 1.875rem;
    height: 0.3125rem;
    fill: currentColor;
  }

  .lightbox__nav--prev svg {
    transform: scaleX(-1);
  }

  .lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 3rem;
  }

  .lightbox__close span {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__close span::before,
  .lightbox__close span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .lightbox__close span::after {
    transform: rotate(-45deg);
  }
</style>
