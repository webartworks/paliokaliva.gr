---
// A plain list with a hairline under each item, flowing into columns on wider screens.
// An item can also be a link, with a short note after it.
export type LineItem = string | { text: string; href: string; note?: string };

interface Props {
  items: readonly LineItem[];
  // Most columns to use on a wide screen.
  columns?: 1 | 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<ul class="line-list" data-columns={columns} data-reveal>
  {
    items.map((item) =>
      typeof item === 'string' ? (
        <li>{item}</li>
      ) : (
        <li>
          <a href={item.href}>{item.text}</a>
          {item.note && <span class="line-list__note">{item.note}</span>}
        </li>
      ),
    )
  }
</ul>

<style>
  .line-list {
    columns: 1;
    column-gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .line-list li {
    break-inside: avoid;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }

  .line-list a {
    color: var(--brown);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
  }

  .line-list a:hover {
    text-decoration-color: currentColor;
  }

  .line-list__note {
    margin-left: 0.5em;
    color: var(--muted);
    font-size: var(--fs-small);
  }

  @media (min-width: 36em) {
    .line-list:not([data-columns='1']) {
      columns: 2;
    }
  }

  @media (min-width: 64em) {
    .line-list[data-columns='3'] {
      columns: 3;
    }
  }
</style>
