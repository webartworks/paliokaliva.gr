---
// Small offer card in the bottom left corner. Content and dates live in src/data/offer.ts.
import ArrowLink from './ArrowLink.astro';
import { t, type Locale } from '@/i18n';
import { offer } from '@/data/offer';
import { site } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const text = offer.text[locale];
---

{
  offer.active && (
    <aside
      class="offer"
      aria-label={dict.offer.eyebrow}
      data-offer={offer.id}
      data-from={offer.from}
      data-until={offer.until}
      hidden
    >
      <button class="offer__close" type="button" aria-label={dict.offer.close} data-offer-close>
        <span aria-hidden="true" />
      </button>
      <span class="eyebrow">{dict.offer.eyebrow}</span>
      <p class="offer__title">{text.title}</p>
      <p class="offer__body">{text.body}</p>
      <ArrowLink href={offer.url || site.bookingUrl}>{text.cta}</ArrowLink>
    </aside>
  )
}

<style>
  .offer {
    position: fixed;
    /* Bottom left: the RateParity widget uses the bottom right corner. */
    left: clamp(0.75rem, 2vw, 1.75rem);
    bottom: clamp(0.75rem, 2vw, 1.75rem);
    z-index: 85;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    width: min(21rem, calc(100vw - 1.5rem));
    padding: 1.75rem 1.75rem 1.25rem;
    background: var(--cream);
    border: 1px solid var(--rule);
    box-shadow: 0 1.5rem 3.5rem -1.5rem rgb(18 17 13 / 0.35);
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.9s var(--ease),
      transform 1.1s var(--ease);
  }

  .offer[hidden] {
    display: none;
  }

  .offer.is-visible {
    opacity: 1;
    transform: none;
  }

  .offer__title {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .offer__body {
    font-size: var(--fs-small);
  }

  .offer__close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--brown);
  }

  .offer__close span {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
  }

  .offer__close span::before,
  .offer__close span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .offer__close span::after {
    transform: rotate(-45deg);
  }

  /* Sit above the Call / WhatsApp / Book bar on phones. */
  @media (max-width: 39.99em) {
    .offer {
      bottom: calc(4rem + env(safe-area-inset-bottom));
    }
  }
</style>
