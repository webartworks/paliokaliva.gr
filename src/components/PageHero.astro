---
// The opening photo of an inner page, with the page title on it.
import { Picture } from 'astro:assets';
import { coverSizes, imageFormats } from '@/lib/images';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  eyebrow?: string;
  // Where the photo is anchored when it is cropped, for example "50% 30%".
  position?: string;
  // A silent video (files in public/) that plays over the photo while it is on screen:
  // `wide` for landscape screens and `tall` for upright ones. Needs the two labels.
  video?: { wide: string; tall?: string };
  videoLabels?: { pause: string; play: string };
}

const { image, alt, title, eyebrow, position = '50% 50%', video, videoLabels } = Astro.props;
---

<section class="page-hero" data-video-box>
  <div class="page-hero__media" style={`--position:${position}`}>
    <Picture
      src={image}
      alt={alt}
      formats={imageFormats}
      widths={[640, 960, 1440, 1920, 2560]}
      sizes={coverSizes(image, 78)}
      loading="eager"
      fetchpriority="high"
    />
    {
      video && (
        <video
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
          data-auto-video={video.wide}
          data-auto-video-tall={video.tall}
        />
      )
    }
  </div>
  {
    video && (
      <button
        class="play-toggle page-hero__toggle"
        type="button"
        hidden
        aria-label={videoLabels?.pause}
        data-video-toggle
        data-pause={videoLabels?.pause}
        data-play={videoLabels?.play}
      >
        <span aria-hidden="true" />
      </button>
    )
  }
  <div class="container page-hero__content">
    {eyebrow && <span class="eyebrow page-hero__eyebrow">{eyebrow}</span>}
    <h1 class="page-hero__title"><span>{title}</span></h1>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(26rem, 78svh, 48rem);
    color: var(--white);
    background: var(--ink);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media :global(picture) {
    display: block;
    height: 100%;
  }

  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }

  .page-hero__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .page-hero__media video.is-playing {
    opacity: 1;
  }

  .page-hero__toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
  }

  .page-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(18 17 13 / 0.4), rgb(18 17 13 / 0) 30%),
      linear-gradient(to top, rgb(18 17 13 / 0.62), rgb(18 17 13 / 0.1) 55%, rgb(18 17 13 / 0) 75%);
  }

  .page-hero__content {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding-block: calc(var(--header-h) + 2rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .page-hero__eyebrow {
    color: inherit;
    animation: page-hero-fade 1.6s var(--ease) 0.6s both;
  }

  .page-hero__title {
    padding-bottom: 0.12em;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .page-hero__title span {
    display: block;
    animation: page-hero-rise 1.8s var(--ease) 0.25s both;
  }

  @keyframes page-hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @keyframes page-hero-fade {
    from {
      opacity: 0;
    }
  }
</style>
