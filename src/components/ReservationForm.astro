---
// Table request form for Meraki, received by src/pages/api/reservation.ts.
import FormFrame from './FormFrame.astro';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const r = dict.reservation;
const f = r.fields;
---

<FormFrame
  locale={locale}
  id="reservation-form"
  action="/api/reservation/"
  submit={r.submit}
  successTitle={r.successTitle}
  successBody={r.successBody}
>
  <label class="field form__wide">
    <span class="field__label">{f.name}</span>
    <input type="text" name="name" autocomplete="name" required minlength="2" maxlength="100" />
  </label>
  <label class="field">
    <span class="field__label">{f.email}</span>
    <input type="email" name="email" autocomplete="email" required maxlength="254" />
  </label>
  <label class="field">
    <span class="field__label">{f.phone}</span>
    <input type="tel" name="phone" autocomplete="tel" required maxlength="40" />
  </label>
  <label class="field">
    <span class="field__label">{f.date}</span>
    <input type="date" name="date" required data-min-today />
  </label>
  <label class="field">
    <span class="field__label">{f.time}</span>
    <input type="time" name="time" required step="900" />
  </label>
  <label class="field">
    <span class="field__label">{f.guests}</span>
    <input type="number" name="guests" required min="1" max="20" value="2" inputmode="numeric" />
  </label>
  <label class="field form__wide">
    <span class="field__label">{f.notes} <small>({dict.form.optional})</small></span>
    <textarea name="notes" rows="3" maxlength="1500" placeholder={f.notesHint}></textarea>
  </label>
</FormFrame>
