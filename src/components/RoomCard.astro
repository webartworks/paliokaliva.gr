---
import { Picture } from 'astro:assets';
import ArrowLink from './ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';
import { roomCovers, roomFacts, type RoomSlug } from '@/data/rooms';
import { routes } from '@/data/site';

interface Props {
  locale: Locale;
  slug: RoomSlug;
  // Position in its row, used to stagger the reveal.
  index?: number;
  // The level of the room name: "h3" under a section title, "h2" otherwise.
  heading?: 'h2' | 'h3';
}

const { locale, slug, index = 0, heading: Heading = 'h3' } = Astro.props;
const r = t(locale).rooms;
const room = r.items[slug];
const facts = roomFacts[slug];
const meta = `${facts.size} m² · ${r.guests.replace('{n}', String(facts.guests))}`;
---

<a class="room" href={localePath(locale, `${routes.accommodation}${slug}/`)}>
  <div class="media room__photo" data-reveal="image" style={`--i:${index}`}>
    <Picture
      src={roomCovers[slug]}
      alt={room.alt}
      formats={['avif', 'webp']}
      widths={[360, 560, 800]}
      sizes="(min-width: 64em) 27vw, (min-width: 40em) 42vw, 74vw"
    />
  </div>
  <div class="room__body" data-reveal style={`--i:${index + 1}`}>
    <Heading class="h3">{room.name}</Heading>
    <p class="room__meta">{meta}</p>
    <p class="room__text">{room.text}</p>
    <ArrowLink>{r.view}</ArrowLink>
  </div>
</a>

<style>
  .room {
    display: block;
  }

  .room__photo {
    aspect-ratio: 3 / 4;
  }

  .room__body {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    padding-top: 1.75rem;
  }

  .room__meta {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .room__text {
    max-width: 19rem;
    margin-bottom: 0.75rem;
    text-wrap: pretty;
  }
</style>
