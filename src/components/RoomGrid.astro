---
// A row of room cards: swipe sideways on phones, a grid from tablets up.
import RoomCard from './RoomCard.astro';
import type { Locale } from '@/i18n';
import type { RoomSlug } from '@/data/rooms';

interface Props {
  locale: Locale;
  slugs: readonly RoomSlug[];
  heading?: 'h2' | 'h3';
}

const { locale, slugs, heading } = Astro.props;
---

<ul class="room-grid">
  {
    slugs.map((slug, i) => (
      <li>
        <RoomCard locale={locale} slug={slug} index={i % 3} heading={heading} />
      </li>
    ))
  }
</ul>

<style>
  /* Phones: one row you swipe sideways, with the next house peeking in. */
  .room-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 74%;
    gap: 1.25rem;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .room-grid::-webkit-scrollbar {
    display: none;
  }

  .room-grid > li {
    scroll-snap-align: start;
  }

  @media (min-width: 40em) {
    .room-grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 1.5rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }

  @media (min-width: 64em) {
    .room-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 4.5rem 1.375rem;
    }
  }
</style>
