---
// The two hand-drawn lines from the design, inlined so they can draw themselves on scroll.
interface Props {
  variant: 'content' | 'footer';
  class?: string;
}

const { variant, class: className } = Astro.props;

const waves = {
  content: {
    viewBox: '0 0 1441 253',
    d: 'M1440.5,252.29c-40.169,-18.934 -120.508,-56.802 -180.528,-65.952c-59.292,-9.04 -122.01,15.864 -179.592,11.049c-56.682,-4.739 -110.016,-29.34 -165.9,-39.937c-56.149,-10.648 -113.639,-19.142 -170.991,-23.947c-59.497,-4.985 -128.826,0.691 -185.992,-5.963c-53.184,-6.19 -103.605,-29.98 -157,-33.958c-53.499,-3.987 -115.771,13.518 -163.991,10.039c-42.917,-3.097 -85.994,-13.729 -125.328,-30.916c-39.334,-17.187 -86.897,-53.866 -110.678,-72.205',
    stroke: '#e0d6ca',
  },
  footer: {
    viewBox: '0 0 1441 198',
    d: 'M0.5,197.496c34.862,-1.838 104.585,-5.513 156.502,-12c53.35,-6.667 108.346,-25.174 163.6,-28c61.916,-3.167 143.748,12.5 207.898,9c59.753,-3.26 127,-20.167 177,-30c41.332,-8.129 81.085,-24.809 123,-29c43.333,-4.333 92.333,7.667 137,3c44.63,-4.663 87.634,-19.471 131,-31c68.333,-18.167 221.667,-66.833 279,-78c21.569,-4.201 50.523,5.933 65,11',
    stroke: '#f3eee8',
  },
} as const;

const wave = waves[variant];
---

<svg
  class:list={['wave', className]}
  viewBox={wave.viewBox}
  aria-hidden="true"
  focusable="false"
  data-reveal
>
  <path d={wave.d} stroke={wave.stroke} pathLength="1"></path>
</svg>
