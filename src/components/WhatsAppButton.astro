---
// A small WhatsApp button in the bottom right corner, on tablets and computers.
// Phones have WhatsApp in the bottom bar instead. The RateParity widget, when it
// loads, sits above this corner.
import { t, type Locale } from '@/i18n';
import { site } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale).dock.whatsappChat;
---

<a
  class="whatsapp"
  href={`https://wa.me/${site.whatsapp}`}
  target="_blank"
  rel="noopener"
  aria-label={label}
  data-whatsapp
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.22 8.23Zm4.51-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48a.92.92 0 0 0-.66.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
    ></path>
  </svg>
  <span class="whatsapp__label">{label}</span>
</a>

<style>
  .whatsapp {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.75rem);
    bottom: clamp(0.75rem, 2vw, 1.75rem);
    z-index: 80;
    display: none;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--cream);
    color: var(--brown);
    box-shadow:
      0 0 0 1px var(--rule),
      0 10px 30px -12px rgb(18 17 13 / 0.35);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.7s var(--ease),
      visibility 0s linear 0.7s,
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .whatsapp.is-visible {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.7s var(--ease),
      visibility 0s,
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .whatsapp:hover,
  .whatsapp:focus-visible {
    background: var(--brown);
    color: var(--cream);
  }

  .whatsapp svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  /* The name of the button, shown to the left of it on hover. */
  .whatsapp__label {
    position: absolute;
    right: calc(100% + 0.75rem);
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--rule),
      0 10px 30px -12px rgb(18 17 13 / 0.3);
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.12em;
    white-space: nowrap;
    opacity: 0;
    translate: 0.5rem 0;
    pointer-events: none;
    transition:
      opacity 0.4s var(--ease),
      translate 0.4s var(--ease);
  }

  .whatsapp:hover .whatsapp__label,
  .whatsapp:focus-visible .whatsapp__label {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp__label {
      translate: none;
    }
  }

  @media (min-width: 40em) {
    .whatsapp {
      display: grid;
    }
  }
</style>
