---
import { Picture } from 'astro:assets';
import heroImage from '@/assets/images/welcome-village.jpg';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import AmenityList from '@/components/AmenityList.astro';
import BookingCta from '@/components/BookingCta.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';
import { baseAmenities, roomFacts, roomPhotos, roomSlugs } from '@/data/rooms';
import { routes, site } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const a = dict.accommodation;
const r = dict.rooms;

const rooms = roomSlugs.map((slug) => {
  const item = r.items[slug];
  const facts = roomFacts[slug];
  const [cover] = roomPhotos(slug);
  return {
    slug,
    ...item,
    cover: cover.image,
    coverAlt: `${item.name}: ${dict.room.kinds[cover.kind]}`,
    meta: `${facts.size} m² · ${r.guests.replace('{n}', String(facts.guests))}`,
    href: localePath(locale, `${routes.accommodation}${slug}/`),
  };
});
---

<Base locale={locale} path={routes.accommodation} title={dict.nav.accommodation} description={a.description} overHero>
  <PageHero image={heroImage} alt={a.heroAlt} title={r.title} eyebrow={r.eyebrow} position="50% 35%" />

  <section class="section bg-cream">
    <div class="container acc-intro">
      <p class="quote-mono" data-reveal>{r.quote}</p>
      <div class="acc-intro__text" data-reveal style="--i:1">
        {a.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ul class="container acc-list">
      {
        rooms.map((room) => (
          <li class="acc-room">
            <a class="media acc-room__photo" href={room.href} tabindex="-1" aria-hidden="true" data-reveal="image">
              <Picture
                src={room.cover}
                alt=""
                formats={['avif', 'webp']}
                widths={[640, 960, 1400]}
                sizes="(min-width: 56em) 52vw, 100vw"
              />
            </a>
            <div class="acc-room__body">
              <h2 class="h2" data-reveal>
                <a href={room.href}>{room.name}</a>
              </h2>
              <p class="acc-room__meta" data-reveal style="--i:1">
                {room.meta}
              </p>
              <p class="acc-room__intro" data-reveal style="--i:2">
                {room.intro}
              </p>
              <ul class="acc-room__facts" data-reveal style="--i:3">
                <li>{room.layout}</li>
                <li>{room.beds}</li>
                <li>{room.bathroom}</li>
              </ul>
              <div class="acc-room__actions" data-reveal style="--i:4">
                <ArrowLink href={room.href}>{a.details}</ArrowLink>
                <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener">
                  {dict.nav.book}
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section bg-linen">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>{a.everyHouse.eyebrow}</span>
        <h2 class="h2" data-reveal style="--i:1">{a.everyHouse.title}</h2>
        <p class="lede" data-reveal style="--i:2">{a.everyHouse.body}</p>
      </div>
      <div class="acc-amenities">
        <AmenityList locale={locale} items={baseAmenities} />
      </div>
    </div>
  </section>

  <BookingCta locale={locale} />
</Base>

<style>
  .acc-intro {
    display: grid;
    justify-items: center;
    gap: 2rem;
    text-align: center;
  }

  .acc-intro__text {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    text-wrap: pretty;
  }

  .acc-list {
    display: grid;
    gap: clamp(4rem, 3rem + 5vw, 8rem);
    margin-top: clamp(4rem, 3rem + 5vw, 7.5rem);
  }

  .acc-room {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .acc-room__photo {
    display: block;
    aspect-ratio: 3 / 2;
  }

  .acc-room__body {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .acc-room__meta {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .acc-room__intro {
    max-width: 28rem;
    margin-top: 0.75rem;
    text-wrap: pretty;
  }

  .acc-room__facts {
    width: 100%;
    max-width: 28rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
  }

  .acc-room__facts li {
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--rule);
  }

  .acc-room__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.25rem;
    margin-top: 1.5rem;
  }

  .acc-amenities {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  @media (min-width: 56em) {
    .acc-room {
      grid-template-columns: 1.25fr 1fr;
      gap: clamp(2.5rem, 7vw, 6.25rem);
    }

    /* Every second house mirrors: text left, photo right. */
    .acc-room:nth-child(even) {
      grid-template-columns: 1fr 1.25fr;
    }

    .acc-room:nth-child(even) .acc-room__photo {
      order: 2;
    }
  }
</style>
