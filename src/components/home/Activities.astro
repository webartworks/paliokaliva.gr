---
import { Picture } from 'astro:assets';
import pottery from '@/assets/images/activity-pottery.jpg';
import wine from '@/assets/images/activity-wine.jpg';
import ArrowLink from '@/components/ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';
import { routes } from '@/data/site';
import { imageFormats } from '@/lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const a = t(locale).activities;
const photos = [pottery, wine];
const href = localePath(locale, routes.activities);
// Each card lands on its own section of the Activities page.
const anchors = ['pottery', 'wine'];
// A silent video that plays over the card's photo while it is on screen (see FeatureSection).
const videos: (string | undefined)[] = ['/video/pottery-workshop.mp4', undefined];
const media = t(locale).media;
---

<section class="activities section bg-linen">
  <div class="container">
    <div class="section-head activities__head">
      <span class="eyebrow" data-reveal>{a.eyebrow}</span>
      <h2 class="h2" data-reveal style="--i:1">{a.title}</h2>
      <p class="lede" data-reveal style="--i:2">{a.body}</p>
    </div>

    <ul class="activities__grid">
      {
        a.items.map((item, i) => (
          <li class="activities__item" data-video-box>
            <a class="activity" href={`${href}#${anchors[i]}`}>
              <div class="media activity__photo" data-reveal="image" style={`--i:${i}`}>
                <Picture
                  src={photos[i]}
                  alt={item.alt}
                  formats={imageFormats}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 48em) 43vw, 100vw"
                />
                {videos[i] && (
                  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-auto-video={videos[i]} />
                )}
              </div>
              <div class="activity__body" data-reveal style={`--i:${i + 1}`}>
                <h3 class="h3">{item.name}</h3>
                <p>{item.text}</p>
              </div>
            </a>
            {
              /* Outside the link, because a button cannot sit inside one. */
              videos[i] && (
                <button
                  class="play-toggle activities__toggle"
                  type="button"
                  hidden
                  aria-label={media.pauseVideo}
                  data-video-toggle
                  data-pause={media.pauseVideo}
                  data-play={media.playVideo}
                >
                  <span aria-hidden="true" />
                </button>
              )
            }
          </li>
        ))
      }
    </ul>

    <div class="activities__more" data-reveal>
      <ArrowLink href={href}>{a.all}</ArrowLink>
    </div>
  </div>
</section>

<style>
  .activities__head .h2 {
    max-width: 30rem;
  }

  .activities__head .lede {
    max-width: 31rem;
  }

  .activities__grid {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3rem);
  }

  .activities__item {
    position: relative;
  }

  /* Top right corner of the photo. */
  .activities__toggle {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    filter: drop-shadow(0 0 0.25rem rgb(18 17 13 / 0.6));
  }

  .activity {
    display: block;
  }

  .activity__photo {
    aspect-ratio: 4 / 5;
  }

  .activity__body {
    display: grid;
    gap: 0.5rem;
    padding-top: 1.75rem;
  }

  .activity__body p {
    max-width: 35rem;
    text-wrap: pretty;
  }

  .activities__more {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 48em) {
    .activities__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }
  }
</style>
