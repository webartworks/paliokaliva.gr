---
import { Picture } from 'astro:assets';
import view from '@/assets/images/location.jpg';
import { localePath, t, type Locale } from '@/i18n';
import { routes } from '@/data/site';
import { imageFormats } from '@/lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const l = t(locale).location;
---

<section class="location section bg-cream">
  <div class="container location__grid">
    <div class="media location__photo" data-reveal="image">
      <Picture
        src={view}
        alt={l.alt}
        formats={imageFormats}
        widths={[640, 960, 1400]}
        sizes="(min-width: 56em) 43vw, 100vw"
      />
    </div>
    <div class="location__content">
      <span class="eyebrow" data-reveal>{l.eyebrow}</span>
      <h2 class="h2" data-reveal style="--i:1">{l.title}</h2>
      <p data-reveal style="--i:2">{l.body}</p>
      <a class="btn" href={`${localePath(locale, routes.contact)}#location`} data-reveal style="--i:3">{l.cta}</a>
    </div>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .location__photo {
    aspect-ratio: 3 / 2;
  }

  .location__content {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 31.5rem;
  }

  .location__content .eyebrow {
    margin-bottom: 1.5rem;
  }

  .location__content p {
    margin-top: 0.75rem;
    text-wrap: pretty;
  }

  .location__content .btn {
    margin-top: 1.75rem;
  }

  @media (min-width: 56em) {
    .location__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 7vw, 6.25rem);
    }
  }
</style>
