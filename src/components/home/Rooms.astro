---
import RoomGrid from '@/components/RoomGrid.astro';
import { t, type Locale } from '@/i18n';
import { roomSlugs } from '@/data/rooms';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const r = t(locale).rooms;
---

<section class="rooms section bg-cream">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-reveal>{r.eyebrow}</span>
      <h2 class="h2" data-reveal style="--i:1">{r.title}</h2>
      <p class="quote-mono" data-reveal style="--i:2">{r.quote}</p>
      <p class="lede" data-reveal style="--i:3">{r.body}</p>
    </div>

    <div class="rooms__grid">
      <RoomGrid locale={locale} slugs={roomSlugs} />
    </div>
  </div>
</section>

<style>
  .rooms {
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .rooms__grid {
    margin-top: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
</style>
