---
import { Picture } from 'astro:assets';
import breakfast from '@/assets/images/life-breakfast.jpg';
import pool from '@/assets/images/life-pool.jpg';
import gardens from '@/assets/images/life-gardens.jpg';
import ArrowLink from '@/components/ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';
import { routes } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const l = t(locale).life;
const photos = [breakfast, pool, gardens];

const items = l.items.map((item, i) => ({
  ...item,
  photo: photos[i],
  href: `${localePath(locale, routes.life)}#${item.anchor}`,
}));
---

<section class="life section bg-linen">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-reveal>{l.eyebrow}</span>
      <h2 class="h2" data-reveal style="--i:1">{l.title}</h2>
      <p class="lede" data-reveal style="--i:2">{l.body}</p>
    </div>

    <ul class="life__grid">
      {
        items.map((item, i) => (
          <li>
            <a class="life__item" href={item.href}>
              <div class="media life__photo" data-reveal="image" style={`--i:${i}`}>
                <Picture
                  src={item.photo}
                  alt={item.alt}
                  formats={['avif', 'webp']}
                  widths={[480, 760, 1140]}
                  sizes="(min-width: 56em) 28vw, 100vw"
                />
              </div>
              <div class="life__body" data-reveal style={`--i:${i + 1}`}>
                <h3 class="h3">{item.name}</h3>
                <p>{item.text}</p>
                <ArrowLink>{l.more}</ArrowLink>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .life__grid {
    display: grid;
    gap: 3.5rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .life__item {
    display: block;
  }

  .life__photo {
    aspect-ratio: 4 / 3;
  }

  .life__body {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    padding-top: 1.75rem;
  }

  .life__body p {
    max-width: 18.5rem;
    margin-bottom: 1rem;
    text-wrap: pretty;
  }

  @media (min-width: 56em) {
    .life__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }

    /* The middle card sits lower, as in the design. */
    .life__grid > li:nth-child(2) {
      margin-top: clamp(2rem, 4.3vw, 3.875rem);
    }
  }
</style>
