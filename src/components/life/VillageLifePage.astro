---
import heroImage from '@/assets/images/life/hero.jpg';
import breakfast from '@/assets/images/life-breakfast.jpg';
import breakfastPies from '@/assets/images/life/breakfast-pies.jpg';
import pool from '@/assets/images/life-pool.jpg';
import poolTerrace from '@/assets/images/life/pool-terrace.jpg';
import gardens from '@/assets/images/life-gardens.jpg';
import gardensPicnic from '@/assets/images/life/gardens-picnic.jpg';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FeatureSection from '@/components/FeatureSection.astro';
import LineList from '@/components/LineList.astro';
import BookingCta from '@/components/BookingCta.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import { localePath, t, type Locale } from '@/i18n';
import { routes } from '@/data/site';
import { breadcrumbSchema } from '@/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const v = dict.villageLife;
const s = v.sections;
const f = v.facilities;
---

<Base
  locale={locale}
  path={routes.life}
  title={dict.nav.life}
  description={v.description}
  overHero
  image={heroImage}
  jsonLd={[breadcrumbSchema(locale, [{ name: dict.nav.life, path: routes.life }])]}
>
  <PageHero image={heroImage} alt={v.heroAlt} title={dict.life.title} eyebrow={dict.life.eyebrow} position="50% 60%" />

  <section class="life-intro bg-cream">
    <div class="container">
      <div class="life-intro__inner" data-reveal>
        {v.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <div class="bg-cream life-features">
    <FeatureSection
      id="breakfast"
      eyebrow={s.breakfast.eyebrow}
      title={s.breakfast.title}
      quote={s.breakfast.quote}
      body={s.breakfast.body}
      image={breakfast}
      alt={s.breakfast.alt}
      smallImage={breakfastPies}
      smallAlt={s.breakfast.altSmall}
    />

    <FeatureSection
      id="pool"
      eyebrow={s.pool.eyebrow}
      title={s.pool.title}
      body={s.pool.body}
      image={pool}
      alt={s.pool.alt}
      smallImage={poolTerrace}
      smallAlt={s.pool.altSmall}
      reverse
    >
      <p class="life-meraki">{v.merakiNote}</p>
      <ArrowLink href={localePath(locale, routes.meraki)}>{dict.nav.meraki}</ArrowLink>
    </FeatureSection>

    <FeatureSection
      id="gardens"
      eyebrow={s.gardens.eyebrow}
      title={s.gardens.title}
      body={s.gardens.body}
      image={gardens}
      alt={s.gardens.alt}
      smallImage={gardensPicnic}
      smallAlt={s.gardens.altSmall}
    />
  </div>

  <section class="section bg-linen" id="facilities">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>{f.eyebrow}</span>
        <h2 class="h2" data-reveal style="--i:1">{f.title}</h2>
        <div class="life-facilities__text" data-reveal style="--i:2">
          {f.body.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="life-facilities__lists">
        <div class="life-facilities__group">
          <div>
            <h3 class="h3" data-reveal>{f.facilitiesTitle}</h3>
            <LineList items={f.facilities} columns={2} />
          </div>
          <div>
            <h3 class="h3" data-reveal>{f.soonTitle}</h3>
            <LineList items={f.soon} columns={2} />
          </div>
        </div>
        <div>
          <h3 class="h3" data-reveal>{f.servicesTitle}</h3>
          <LineList items={f.services} columns={2} />
        </div>
      </div>

      <div class="life-facilities__more" data-reveal>
        <ArrowLink href={localePath(locale, routes.activities)}>{dict.activities.all}</ArrowLink>
      </div>
    </div>
  </section>

  <BookingCta locale={locale} />
</Base>

<style>
  .life-intro {
    padding-top: var(--section);
  }

  .life-intro__inner {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
    text-wrap: pretty;
  }

  .life-features {
    padding-block: calc(var(--section) * 0.4) calc(var(--section) * 0.6);
  }

  .life-meraki {
    max-width: 30rem;
    margin-bottom: 0.5rem;
  }

  .life-facilities__text {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    text-wrap: pretty;
  }

  .life-facilities__lists {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .life-facilities__lists .h3 {
    margin-bottom: 1rem;
  }

  .life-facilities__group {
    display: grid;
    gap: 3rem;
  }

  .life-facilities__more {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 64em) {
    .life-facilities__lists {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 7vw, 6.25rem);
    }
  }
</style>
