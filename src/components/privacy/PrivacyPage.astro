---
import Base from '@/layouts/Base.astro';
import { htmlLang, t, type Locale } from '@/i18n';
import { routes, site } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const p = dict.privacyPage;

const updated = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long' }).format(
  new Date(`${site.legal.privacyUpdated}T12:00:00`),
);
const showCookieSettings = Boolean(site.rateParityScript && site.rateParityNeedsConsent);
---

<Base locale={locale} path={routes.privacy} title={dict.nav.privacy} description={p.description}>
  <article class="privacy bg-cream">
    <div class="container privacy__inner">
      <header class="privacy__head">
        <span class="eyebrow">{p.eyebrow}</span>
        <h1 class="h2 privacy__title">{p.title}</h1>
        <p class="privacy__updated">{p.updated.replace('{date}', updated)}</p>
        <p class="privacy__intro">{p.intro}</p>
      </header>

      <section>
        <h2 class="h3">{p.controllerTitle}</h2>
        <p>{p.controllerBody}</p>
        <address>
          {site.legal.company && <span>{site.legal.company}</span>}
          {dict.footer.address.map((line) => <span>{line}</span>)}
          <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
          <span><a href={`tel:${site.phone.href}`}>{site.phone.label}</a></span>
          {site.legal.vat && <span>{p.vat}: {site.legal.vat}</span>}
          {site.legal.gemi && <span>{p.gemi}: {site.legal.gemi}</span>}
        </address>
      </section>

      {
        p.sections.map((section, i) => (
          <section>
            <h2 class="h3">{section.title}</h2>
            {section.body.map((text) => (
              <p>{text}</p>
            ))}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {section.after?.map((text) => (
              <p>{text}</p>
            ))}
            {
              // The cookies section (fourth in the texts) carries the button to change the choice.
              i === 3 && showCookieSettings && (
                <button class="btn" type="button" data-consent-open>
                  {dict.consent.settings}
                </button>
              )
            }
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .privacy {
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem)) var(--section);
  }

  .privacy__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .privacy__inner > * {
    width: 100%;
    max-width: 44rem;
  }

  .privacy__head {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .privacy__head .eyebrow {
    margin-bottom: 1.25rem;
  }

  .privacy__title {
    font-size: clamp(2.25rem, 1.6rem + 2.8vw, 3.5rem);
    line-height: 1.02;
  }

  .privacy__updated {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .privacy__intro {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
  }

  .privacy section {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-top: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    border-top: 1px solid var(--rule);
  }

  .privacy section p,
  .privacy section li {
    text-wrap: pretty;
  }

  .privacy ul {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .privacy li::marker {
    color: var(--brown);
  }

  .privacy address span {
    display: block;
  }

  .privacy address a {
    border-bottom: 1px solid var(--rule);
  }

  .privacy .btn {
    margin-top: 0.5rem;
  }
</style>
