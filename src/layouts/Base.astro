---
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/open-sans';
import '@fontsource-variable/fira-code';
import '@/styles/global.css';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileDock from '@/components/MobileDock.astro';
import OfferPopup from '@/components/OfferPopup.astro';
import CookieNotice from '@/components/CookieNotice.astro';
import { htmlLang, localePath, locales, ogLocale, t, type Locale } from '@/i18n';
import { site } from '@/data/site';

interface Props {
  locale: Locale;
  // Path without the language prefix, for example "/accommodation/".
  path: string;
  title?: string;
  description?: string;
  // True when the page starts with a full-height photo behind the header.
  overHero?: boolean;
  // True for pages search engines should not list.
  noindex?: boolean;
}

const { locale, path, title, description, overHero = false, noindex = false } = Astro.props;
const dict = t(locale);

const pageTitle = title ? `${title} | ${site.name}` : dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const canonical = new URL(localePath(locale, path), site.url).href;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(l, path), site.url).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(path, site.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="theme-color" content="#f9f4ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      // Visitor statistics (Umami, no cookies). Only on the published site, once the ID is set.
      import.meta.env.PROD && site.analytics.websiteId && (
        <script
          is:inline
          defer
          src={site.analytics.src}
          data-website-id={site.analytics.websiteId}
          data-do-not-track="true"
        />
      )
    }

    <script is:inline>
      // Content is only held back for the reveal animations when scripts run.
      // If the main script has not started after 3 seconds, show everything.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__paliokaliva) document.documentElement.classList.remove('js');
      }, 3000);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>
    <Header locale={locale} path={path} overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <MobileDock locale={locale} />
    <OfferPopup locale={locale} />
    <CookieNotice locale={locale} />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
