---
// Temporary page for every address in the sitemap that is not built yet.
// As each real page is added under src/pages, remove its entry from the list below.
import Base from '@/layouts/Base.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import { localePath, locales, t, type Locale } from '@/i18n';
import { routes, type RouteKey } from '@/data/site';

export function getStaticPaths() {
  const pending: RouteKey[] = [
    'village',
    'life',
    'meraki',
    'activities',
    'zakynthos',
    'contact',
    'gallery',
    'privacy',
  ];

  return locales.flatMap((locale) => {
    const dict = t(locale);
    const pages = pending.map((key) => ({ path: routes[key], title: dict.nav[key] }));

    return pages.map(({ path, title }) => ({
      params: { path: localePath(locale, path).replace(/^\/|\/$/g, '') },
      props: { locale, path, title },
    }));
  });
}

interface Props {
  locale: Locale;
  path: string;
  title: string;
}

const { locale, path, title } = Astro.props;
const p = t(locale).placeholder;
---

<Base locale={locale} path={path} title={title}>
  <section class="placeholder container">
    <span class="eyebrow">{p.eyebrow}</span>
    <h1 class="h2">{title}</h1>
    <p>{p.body}</p>
    <ArrowLink href={localePath(locale, routes.home)}>{p.back}</ArrowLink>
  </section>
</Base>

<style>
  .placeholder {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 1.25rem;
    min-height: 80svh;
    padding-block: calc(var(--header-h) + 4rem) 6rem;
  }
</style>
